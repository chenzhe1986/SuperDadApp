{
    "name" : "全能小学霸",
    "appid" : "",
    "description" : "面向小学生的趣味知识问答闯关APP",
    "versionName" : "1.0.0",
    "versionCode" : "100",
    "transformPx" : false,
    /* 使用 Vue3 编译（HBuilderX 3.2+ 支持） */
    "vueVersion" : "3",
    /* App(安卓/iOS)平台特有配置 */
    "app-plus" : {
        "usingComponents" : true,
        "nvueStyleCompiler" : "uni-app",
        "compilerVersion" : 3,
        /* 启动界面配置：不等待首页渲染完成就关闭启动图会白屏，保持默认即可 */
        "splashscreen" : {
            "alwaysShowBeforeRender" : true,
            "waiting" : true,
            "autoclose" : true,
            "delay" : 0
        },
        /* APP打包所需的模块配置，本项目无需额外原生模块 */
        "modules" : {},
        /* 应用发布信息 */
        "distribute" : {
            /* 安卓打包配置 */
            "android" : {
                /* 本APP为纯本地应用，仅声明最基础权限，保护儿童隐私 */
                "permissions" : [],
                /* 屏幕方向：竖屏锁定，适合儿童手持使用 */
                "autoSdkPermissions" : false
            },
            "ios" : {},
            "sdkConfigs" : {}
        },
        /* 竖屏锁定 */
        "screenOrientation" : [ "portrait-primary" ]
    },
    /* 微信小程序特有配置 */
    "mp-weixin" : {
        "appid" : "",
        "setting" : {
            "urlCheck" : false,
            "es6" : true,
            "minified" : true
        },
        "usingComponents" : true
    },
    /* H5 特有配置（方便在浏览器里调试预览） */
    "h5" : {
        "title" : "全能小学霸",
        "router" : {
            "mode" : "hash"
        }
    },
    "uniStatistics" : {
        "enable" : false
    }
}
